// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  Admin
  Owner
  Trainer
  User
  Fitrainer
}

enum MemberRole {
  Owner
  Trainer
}

model User {
  id                 String              @id
  name               String
  email              String
  role               Role                @default(User)
  emailVerified      Boolean
  image              String?
  createdAt          DateTime
  updatedAt          DateTime
  ownedOrganizations Organization[]      @relation("OrganizationOwner")
  trainerApplication TrainerApplication? @relation("TrainerApplicationApplicant")

  assignedApplications TrainerApplication[] @relation("TrainerApplicationAdmin")

  sessions    Session[]
  accounts    Account[]
  members     Member[]
  invitations Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  issuer String?

  @@index([userId])
  @@map("account")
  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
  @@map("verification")
}

model TrainerApplication {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("TrainerApplicationApplicant", fields: [userId], references: [id], onDelete: Cascade)

  fullName       String
  email          String
  gender         String?
  dob            DateTime?
  specialization String
  experience     String?
  certifications String[]
  bio            String            @db.Text
  panNumber      String            @unique
  brand          String
  designation    String
  social         String?
  profileImage   String
  dryRun         Boolean           @default(false)
  city           String
  country        String
  status         ApplicationStatus @default(PENDING)
  notes          String?
  adminId        String?
  admin          User?             @relation("TrainerApplicationAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  adminComment   String?
  dryRunMessage  String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?      @unique
  createdAt   DateTime
  metadata    String?
  ownerId     String       @unique
  owner       User         @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members     Member[]
  invitations Invitation[]
  plans       Plan[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole
  createdAt      DateTime
  dob            DateTime?
  specialization String
  experience     String?
  certifications String[]
  bio            String       @db.Text
  panNumber      String       @unique
  designation    String
  social         String?
  profileImage   String

  city    String
  country String

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

model Plan {
  id String @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String @db.Text

  actualPrice      Int
  offerPrice       Int
  currency         String   @default("INR")
  level            String
  duration         Int
  planLogo         String
  shortInfo        String
  blogspotAccess   Boolean  @default(false)
  trainingSchedule Boolean  @default(false)
  progressTracking Boolean  @default(false)
  chatAccess       Boolean  @default(false)
  dietInstructions Boolean  @default(false)
  trainingVideos   Boolean  @default(false)
  privateSession   Boolean  @default(false)
  equipment        String
  goal             String
  achievements     String[]
  programType      String
  restDays         String
  recomendedFor    String
  focusArea        String
  duration1        String
  duration1Info    String
  duration2        String
  duration2Info    String
  duration3        String
  duration3Info    String
  programStructure String
  isActive         Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime 
  vector      PlanVector[]
  @@index([organizationId])
  @@unique([organizationId, name])
  @@map("plan")
}

model PlanVector {
  id         String   @id @default(cuid())
  planId     String
  content    String   @db.Text
  chunkIndex Int
  embedding  Unsupported("vector(1536)")
  createdAt  DateTime @default(now())

  plan Plan @relation(fields: [planId],references: [id],  onDelete: Cascade)

  @@index([planId])
  @@unique([planId, chunkIndex])

  @@map("plan_vector")
}
